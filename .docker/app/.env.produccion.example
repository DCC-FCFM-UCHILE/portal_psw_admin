# Para copiar a .env y completar lo vacío. Si falta algo OBLIGATORIO, el
# portal no arranca y docker logs dice qué variable es la que está ausente

DJANGO_SETTINGS_MODULE=core.settings.production
DJANGO_SECRET_KEY=

# Por el momento, se asume el subdominio adminpsw.apps.dcc.uchile.cl
DJANGO_ALLOWED_HOSTS=adminpsw.apps.dcc.uchile.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://adminpsw.apps.dcc.uchile.cl
DJANGO_COOKIE_PATH=/

# Información de conexión con la base de datos
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=5432

# Información de correo para Django
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=no-reply@dcc.uchile.cl

# Datos que lee docker compose al levantar el contenedor. Por ahora se dejan comentadas, y valen lo que se muestra aquí abajo 
# DESPLIEGUE_HOSTNAME=adminpsw.apps.dcc.uchile.cl
# DESPLIEGUE_RED=nginx-proxy
# DESPLIEGUE_ESTATICOS=/home/instalar/static/portal-admin-psw/
# DESPLIEGUE_ARCHIVOS=/home/instalar/media/portalpsw2/
# DESPLIEGUE_UID=1001
# DESPLIEGUE_GID=100
# DESPLIEGUE_PREFIJO=

# Bajo una ruta de un dominio compartido (ambiente de pruebas, test.dcc.uchile.cl/portal-psw-admin/)
# en vez de un subdominio propio, se cambian estas líneas:
# DJANGO_ALLOWED_HOSTS=test.dcc.uchile.cl
# DJANGO_CSRF_TRUSTED_ORIGINS=https://test.dcc.uchile.cl
# DJANGO_COOKIE_PATH=/portal-psw-admin/
# DJANGO_SESSION_COOKIE_NAME=sessionid_portal_psw_admin
# DJANGO_CSRF_COOKIE_NAME=csrftoken_portal_psw_admin
# DESPLIEGUE_PREFIJO=/portal-psw-admin
