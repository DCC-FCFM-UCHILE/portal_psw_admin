# Producción. Se copia a .env y se completa lo vacío. Si falta algo obligatorio, el
# portal no arranca y docker logs dice qué variable es.
# Docker no expande ${...} en este archivo: los valores van escritos tal cual.

DJANGO_SETTINGS_MODULE=core.settings.production
# Una por portal: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=

# Separados por coma, sin espacios. Con https:// en los orígenes
DJANGO_ALLOWED_HOSTS=adminpsw.apps.dcc.uchile.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://adminpsw.apps.dcc.uchile.cl
# Si el portal comparte host con otro bajo una subruta, esa subruta
DJANGO_COOKIE_PATH=/

# Base compartida, la misma del portal público. El usuario necesita leer, insertar,
# actualizar y borrar
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=5432

# Usuario y contraseña pueden quedar vacíos si el servidor no pide autenticación
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=no-reply@dcc.uchile.cl

# Las lee docker compose al levantar el contenedor. Comentadas, valen lo que se muestra
# DESPLIEGUE_HOSTNAME=adminpsw.apps.dcc.uchile.cl
# DESPLIEGUE_RED=nginx-proxy
# DESPLIEGUE_ESTATICOS=/home/instalar/static/portal-admin-psw/
# DESPLIEGUE_ARCHIVOS=/home/instalar/media/portalpsw2/
# DESPLIEGUE_UID=1001
# DESPLIEGUE_GID=100
