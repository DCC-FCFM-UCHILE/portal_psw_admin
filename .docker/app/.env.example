######################################
# Django settings
######################################

# Desarrollo. Producción tiene otro módulo de configuración
DJANGO_SETTINGS_MODULE=core.settings.docker
DJANGO_SECRET_KEY=SECRET_PLACEHOLDER

######################################
# Base de datos (la misma que del portal público)
######################################

# Información de conexión con la base de datos
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=portal_psw
DJANGO_DB_USER=desarrollo
DJANGO_DB_PASSWORD=PASSWD-PLACEHOLDER
DJANGO_DB_HOST=postgresql-portal-publico
DJANGO_DB_PORT=5432

######################################
# Archivos
######################################

# Por omisión /static y /media. MEDIA tiene que ser el mismo directorio para el portal público y el actual
# DJANGO_STATIC_ROOT=/static
# DJANGO_MEDIA_ROOT=/media

######################################
# Correo
######################################

# Información de correo para Django
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=no-reply@dcc.uchile.cl