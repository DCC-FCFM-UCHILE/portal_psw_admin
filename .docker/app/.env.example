######################################
# Django settings
######################################

# En producción: core.settings.production
DJANGO_SETTINGS_MODULE=core.settings.docker
# Genere con: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=SECRET_PLACEHOLDER

######################################
# Producción (las exige core.settings.production)
######################################

# Separados por coma, sin espacios
DJANGO_ALLOWED_HOSTS=adminpsw.apps.dcc.uchile.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://adminpsw.apps.dcc.uchile.cl
# Ruta de las cookies de sesión y CSRF. Si el portal comparte host con otro bajo una subruta, esa subruta
DJANGO_COOKIE_PATH=/

######################################
# Base de datos (la misma del portal público)
######################################

# Docker no expande ${...} en un env_file: los valores van escritos tal cual
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=portal_psw
DJANGO_DB_USER=desarrollo
DJANGO_DB_PASSWORD=PASSWD-PLACEHOLDER
DJANGO_DB_HOST=postgresql-portal-publico
DJANGO_DB_PORT=5432

######################################
# Archivos
######################################

# Por omisión /static y /media. MEDIA tiene que ser el mismo directorio del portal público y del actual
# DJANGO_STATIC_ROOT=/static
# DJANGO_MEDIA_ROOT=/media

######################################
# Correo
######################################

# En desarrollo: django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=no-reply@dcc.uchile.cl

######################################
# Desarrollo desde un teléfono
######################################

# IP del PC en la red local, separadas por coma. Solo la lee core.settings.docker
# DJANGO_HOSTS_LOCALES=
